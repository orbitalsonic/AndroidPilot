<?xml version="1.0" encoding="utf-8"?>
<!--
  Template — copy to the module that hosts NotificationSender: res/layout/firebase_notification_view.xml
  RemoteViews layout (QiblaCompass shape): RemoteViews supports only FrameLayout / LinearLayout /
  RelativeLayout / GridLayout + basic widgets — no ConstraintLayout, no Material / Shapeable views.
  Text colors are set at runtime (day / night) by NotificationSender.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp">

        <ImageView
            android:id="@+id/ivFcmIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:visibility="gone"
            tools:src="@tools:sample/avatars"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/ivFcmIcon"
            android:layout_alignBottom="@id/ivFcmIcon"
            android:layout_toEndOf="@id/ivFcmIcon"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFcmTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:ellipsize="end"
                android:lines="1"
                android:textStyle="bold"
                tools:text="Notification title" />

            <TextView
                android:id="@+id/tvFcmBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Notification body" />

        </LinearLayout>

    </RelativeLayout>

    <ImageView
        android:id="@+id/ivFcmFeature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone"
        tools:src="@tools:sample/backgrounds/scenic"
        tools:visibility="visible" />

</LinearLayout>
